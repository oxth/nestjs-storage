{
  "name": "@oxth/nestjs-storage",
  "version": "0.2.0",
  "description": "NestJS storage module with one API for local disk, Amazon S3, Cloudflare R2, Google Cloud Storage, Azure Blob and S3-compatible services",
  "author": "OxTH",
  "license": "MIT",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://oxth.github.io/nestjs-storage/",
  "repository": {
    "type": "git",
    "url": "https://github.com/oxth/nestjs-storage.git"
  },
  "bugs": {
    "url": "https://github.com/oxth/nestjs-storage/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "nestjs",
    "nestjs-module",
    "storage",
    "file-storage",
    "file-upload",
    "multer",
    "multipart",
    "filesystem",
    "local-storage",
    "s3",
    "aws",
    "cloudflare",
    "r2",
    "cloudflare-r2",
    "gcs",
    "google-cloud-storage",
    "azure",
    "azure-blob-storage",
    "blob-storage",
    "minio",
    "backblaze",
    "digitalocean-spaces",
    "wasabi",
    "presigned-url",
    "signed-url",
    "flydrive"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.d.ts",
    "dist/**/*.d.mts",
    "llm.md",
    "llm-full.md"
  ],
  "scripts": {
    "build": "tsup && tsc-alias -p tsconfig.build.json && node scripts/fix-esm-extensions.mjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "pnpm build",
    "preversion": "pnpm lint && pnpm test:cov",
    "postversion": "git push --follow-tags",
    "brand:build": "node scripts/brand/build.mjs"
  },
  "dependencies": {
    "@nestjs/platform-express": "^12.3.2",
    "@poppinss/string": "^1.7.2",
    "flydrive": "^2.2.0",
    "multer": "^2.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/cloudfront-signer": "^3",
    "@aws-sdk/s3-request-presigner": "^3",
    "@azure/storage-blob": "^12",
    "@google-cloud/storage": "^7",
    "@nestjs/common": "^10 || ^11 || ^12"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/cloudfront-signer": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    },
    "@azure/storage-blob": {
      "optional": true
    },
    "@google-cloud/storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/cloudfront-signer": "^3.1161.0",
    "@aws-sdk/s3-presigned-post": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@azure/storage-blob": "^12.34.0",
    "@eslint/js": "^10.0.1",
    "@google-cloud/storage": "^8.4.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsc-alias": "^1.9.10",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.12"
  }
}
