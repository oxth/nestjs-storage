{
  "name": "@oxth/nestjs-storage",
  "version": "0.0.1",
  "description": "NestJS storage module with a unified API for Local, S3, R2, GCS, MinIO, Azure, B2, DigitalOcean Spaces, and Wasabi drivers",
  "author": "OxTH",
  "license": "MIT",
  "homepage": "https://github.com/oxth/nestjs-storage#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/oxth/nestjs-storage.git"
  },
  "bugs": {
    "url": "https://github.com/oxth/nestjs-storage/issues"
  },
  "keywords": [
    "nestjs",
    "storage",
    "filesystem",
    "s3",
    "aws",
    "cloudflare",
    "r2",
    "gcs",
    "google-cloud-storage",
    "azure",
    "blob-storage",
    "minio",
    "backblaze",
    "digitalocean-spaces",
    "wasabi",
    "file-upload",
    "multipart",
    "local-storage",
    "encryption",
    "presigned-url"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.d.ts",
    "dist/**/*.d.mts",
    "llm.md",
    "llm-full.md"
  ],
  "scripts": {
    "build": "tsup",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1094.0",
    "@aws-sdk/s3-request-presigner": "^3.1094.0",
    "@google-cloud/storage": "^7.21.0",
    "@nestjs/platform-express": "^11.1.28",
    "@poppinss/string": "^1.7.2",
    "flydrive": "^2.1.0",
    "multer": "^2.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "@aws-sdk/cloudfront-signer": "^3.1088.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/cloudfront-signer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/cloudfront-signer": "^3.1088.0",
    "@aws-sdk/s3-presigned-post": "^3.1094.0",
    "@azure/storage-blob": "^12.33.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@smithy/types": "^4.16.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "archiver": "^8.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
